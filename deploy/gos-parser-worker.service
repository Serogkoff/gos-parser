[Unit]
Description=Gos Parser news collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gosparser
Group=www-data
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=/etc/gos-parser.env
ExecStart=__PROJECT_DIR__/.venv/bin/python -u __PROJECT_DIR__/main.py
Restart=always
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__PROJECT_DIR__

[Install]
WantedBy=multi-user.target
