PYTHONUNBUFFERED=1
MONITOR_HTTPS=0
MONITOR_SECRET_KEY=replace-with-a-long-random-value
NEWS_DATABASE_PATH=__PROJECT_DIR__/news.db
NEWS_BACKUP_DIR=__PROJECT_DIR__/backups
PLAYWRIGHT_BROWSERS_PATH=__PROJECT_DIR__/.playwright

# Только Киодо использует этот SOCKS5. Не добавляйте настоящий пароль в Git.
KYODO_PROXY_HOST=proxy.example
KYODO_PROXY_PORT=1080
KYODO_PROXY_USERNAME=username
KYODO_PROXY_PASSWORD=password
