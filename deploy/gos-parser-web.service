[Unit]
Description=Gos Parser web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gosparser
Group=www-data
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=/etc/gos-parser.env
RuntimeDirectory=gos-parser
RuntimeDirectoryMode=0750
ExecStart=__PROJECT_DIR__/.venv/bin/gunicorn \
    --workers 1 \
    --threads 4 \
    --timeout 180 \
    --graceful-timeout 30 \
    --umask 007 \
    --bind unix:/run/gos-parser/web.sock \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
Restart=always
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__PROJECT_DIR__ /run/gos-parser

[Install]
WantedBy=multi-user.target
