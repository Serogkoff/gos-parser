# Только Киодо/47NEWS использует этот маршрут. Настоящий пароль не коммитьте.
KYODO_PROXY_HOST=server.example
KYODO_PROXY_PORT=1080
KYODO_PROXY_USERNAME=username
KYODO_PROXY_PASSWORD=password

# Необязательный резерв. Он включается автоматически, только если основной
# маршрут не отвечает. Пароль также храните только в локальном .env.
KYODO_PROXY_BACKUP_HOST=backup.example
KYODO_PROXY_BACKUP_PORT=1080
KYODO_PROXY_BACKUP_USERNAME=username
KYODO_PROXY_BACKUP_PASSWORD=password

# Альтернатива четырём резервным строкам:
# KYODO_PROXY_BACKUP_URL=socks5h://username:password@backup.example:1080

# Альтернатива четырём строкам выше:
# KYODO_PROXY_URL=socks5h://username:password@server.example:1080
